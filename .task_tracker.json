{
  "task_description": "{'component_name': 'Main Container for SplitEase', 'description': 'Primary container for SplitEase implementation: SnapSplit is a responsive web app that lets users upload bill/receipt images, extract itemized data using Google Cloud Vision OCR, and split expenses among friends. It features authentication, a dashboard for uploads and history, real-time item assignment, payment integration, and modern UI.', 'interfaces': [], 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "SplitEase-35777 frontend Container",\n  "features": [\n    {\n      "name": "User Authentication",\n      "description": "Users can sign up or log in using email/password or Google OAuth via Supabase Auth.",\n      "isEnabled": true\n    },\n    {\n      "name": "Receipt Upload & Storage",\n      "description": "Users can upload JPG, PNG, or PDF receipts, which are stored securely in Supabase Storage.",\n      "isEnabled": true\n    },\n    {\n      "name": "OCR Item Extraction",\n      "description": "Google Cloud Vision API parses uploaded receipts to extract item names, prices, subtotal, tax, and total.",\n      "isEnabled": true\n    },\n    {\n      "name": "Dashboard",\n      "description": "Central dashboard to upload new receipts and view past receipts with quick access.",\n      "isEnabled": true\n    },\n    {\n      "name": "Item Assignment UI",\n      "description": "Visual interface (drag-and-drop or checkboxes) to assign each line item to friends in the group.",\n      "isEnabled": true\n    },\n    {\n      "name": "Real-time Split Calculation",\n      "description": "Automatically calculates each person\'s share, including tax and tip, updating in real time as items are assigned.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settle-up Page",\n      "description": "Users can send or request payments via Venmo or PayPal API integration.",\n      "isEnabled": true\n    },\n    {\n      "name": "History & Export",\n      "description": "View all past bills, see who paid, and export receipt breakdowns as PDF.",\n      "isEnabled": true\n    },\n    {\n      "name": "Database Integration",\n      "description": "Supabase Database stores users, receipts, items, and payment status for persistent data management.",\n      "isEnabled": true\n    },\n    {\n      "name": "Modern UI/UX",\n      "description": "TailwindCSS-powered modern interface with smooth transitions and responsive design.",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#2563eb",\n    "secondary": "#f1f5f9",\n    "accent": "#f59e42"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI features a responsive dashboard with a sidebar for navigation (Dashboard, History, Settle-up). The main area displays receipt upload and history. After uploading, a modal or page shows extracted items with a drag-and-drop or checkbox interface for assigning items to friends. Real-time split calculations are shown in a summary panel. The Settle-up page integrates payment options. All pages use modern, clean layouts with TailwindCSS and smooth transitions."\n}'}",
